<?xml version="1.0"?>

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:layout_height="match_parent" android:layout_width="match_parent" android:id="@+id/swipeRefresh" xmlns:android="http://schemas.android.com/apk/res/android">


<ScrollView android:layout_height="match_parent" android:layout_width="match_parent">


<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:padding="16dp" android:orientation="vertical">

<TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:textStyle="bold" android:textSize="28sp" android:text="Shipper FOOD_KCN"/>


<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/loginPanel" android:orientation="vertical">

<TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:textSize="13sp" android:text="Khu công nghiệp" android:paddingTop="8dp"/>

<Spinner android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/kcnSpinner"/>

<EditText android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/username" android:hint="Tên đăng nhập"/>

<EditText android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/password" android:hint="Mật khẩu" android:inputType="textPassword"/>

<Button android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/loginBtn" android:text="Đăng nhập"/>

</LinearLayout>


<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/appPanel" android:orientation="vertical" android:visibility="gone">

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/kcnBadge" android:textStyle="bold" android:textSize="16sp" android:paddingTop="8dp"/>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/walletBadge" android:textSize="14sp" android:paddingBottom="4dp"/>

<Button android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/topupBtn" android:text="💳 Nạp tiền gối đầu"/>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/codBadge" android:textSize="14sp" android:paddingBottom="4dp"/>


<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

<Button android:layout_height="wrap_content" android:layout_width="0dp" android:id="@+id/refreshBtn" android:text="↻ Đồng bộ" android:layout_weight="1"/>

<Button android:layout_height="wrap_content" android:layout_width="0dp" android:id="@+id/logoutBtn" android:text="Đăng xuất" android:layout_weight="1"/>

</LinearLayout>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:textStyle="bold" android:textSize="18sp" android:text="🛵 Đơn đang cầm" android:paddingTop="16dp"/>

<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/myOrdersBox" android:orientation="vertical"/>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:textStyle="bold" android:textSize="18sp" android:text="📦 Đơn sẵn sàng để nhận" android:paddingTop="16dp"/>

<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/ordersBox" android:orientation="vertical"/>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:textStyle="bold" android:textSize="18sp" android:text="📊 Thống kê của tôi" android:paddingTop="16dp"/>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/statsBox" android:textSize="14sp" android:text="Đang tải thống kê..." android:lineSpacingExtra="4dp"/>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:textStyle="bold" android:textSize="18sp" android:text="🕘 Lịch sử giao hàng" android:paddingTop="16dp"/>

<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/historyBox" android:orientation="vertical"/>

<Button android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/loadMoreHistoryBtn" android:text="Xem thêm" android:visibility="gone"/>

</LinearLayout>

<TextView android:layout_height="wrap_content" android:layout_width="match_parent" android:id="@+id/status" android:paddingTop="12dp"/>

</LinearLayout>

</ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
